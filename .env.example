# Copy this file to .env and fill in the services you want to use.
# Vercel checklist and worker/tunnel setup: VERCEL_DEPLOYMENT.md.
# Check deployment values with npm run deploy:check -- https://YOUR-DOMAIN.
#   Copy-Item .env.example .env
# The key is used server-side only and is never exposed to the browser.

# Supabase database + private Storage. Run supabase/schema.sql in the SQL Editor.
# Both values are required together; leaving both blank keeps local JSON storage.
# Vercel requires these values in Project Settings > Environment Variables too.
# Use the legacy service_role JWT key (not the anon/public key).
# Never prefix this key with VITE_ or expose it to client-side code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=meditrace-attachments

# Demo accounts: local mode seeds them by default; cloud mode does not.
# For a fresh demo deployment, set true to enable the documented demo logins.
# If migrating existing local data, run npm run db:migrate before enabling seeding.
SEED_DEMO_USERS=
# Show fictional records in the doctor platform only when explicitly enabled.
SHOW_DEMO_PATIENTS=false
# Optional: hide older intakes in the doctor list without deleting patient data.
DOCTOR_RECORDS_SINCE=

# Medical document OCR + medical NLP. Host services/document_pipeline separately
# from Vercel, with a persistent queue/model-cache volume. Both values are needed.
# Use HTTPS for a remote service; http://127.0.0.1:8000 is for local development.
DOCUMENT_PIPELINE_URL=
DOCUMENT_PIPELINE_TOKEN=

# Set these on the Python worker, not in VITE_ variables. Defaults shown here:
# MEDICAL_TROCR_MODEL=aci-mis-team/trocr-large-handwritten-prescription
# MEDICAL_TROCR_PROCESSOR=aci-mis-team/trocr-large-handwritten-prescription
# MEDICAL_NLP_MODEL=d4data/biomedical-ner-all
# DOCUMENT_QUEUE_PATH=/data/jobs.sqlite3
# DOCUMENT_MAX_PAGES=12
# HF_HOME=/data/models
# OCR provider: ocr_space (default), google_vision, or local. OCR.space needs a
# free API key from https://ocr.space/ocrapi. It uploads document page images to
# OCR.space and the free tier accepts files up to 1 MB and 500 requests/day/IP.
DOCUMENT_OCR_PROVIDER=ocr_space
OCR_SPACE_API_KEY=
# Engine 2 favors speed; use 3 only when its slower handwriting/table accuracy is needed.
OCR_SPACE_ENGINE=2
# Google Cloud Vision is available as an alternative. It requires enabled billing
# and sends document page images to Google.
GOOGLE_CLOUD_VISION_API_KEY=
# Keep false for fast, actionable Google OCR failures. Set true only when the
# slow local TrOCR fallback is wanted after a Google outage.
GOOGLE_VISION_FALLBACK_TO_TROCR=false

ELEVENLABS_API_KEY=

# Optional: ElevenLabs voice used for spoken prompts (text-to-speech).
# The default works on ElevenLabs' free plan. Library voices usually require a
# paid plan and will return "paid_plan_required"; the app falls back to your
# device voice in that case. Find IDs at https://elevenlabs.io/app/voice-library
#   Free-plan friendly examples: EXAVITQu4vr4xnSDxMaL (Bella), ErXwobaYiN019PkySvjV (Antoni)
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Optional: Google Gemini API key (Google AI Studio). Used server-side for:
#   * speech-to-text (transcription of the patient's voice input), and
#   * the adaptive clinical intake (choosing the next question, flagging warning
#     signs already covered by the rules; it never diagnoses or invents questions).
# If unset, transcription falls back to the browser SpeechRecognition API and the
# intake runs fully rule-based. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Gemini speech-to-text model. `gemini-3.5-transcribe` is the default.
# GEMINI_STT_MODEL=gemini-3.5-transcribe

# Optional: extra comma-separated terms to bias transcription toward (medicine
# brand names, etc.). A built-in list of common Indian medication names is always
# included; this only adds to it.
# GEMINI_STT_VOCABULARY=MyBrandName,AnotherDrug

# Optional: Gemini model. `gemini-3.5-flash` is used by default.
# Availability and API quota depend on your Google AI Studio project.
# GEMINI_MODEL=gemini-3.5-flash

# Adaptive question provider: gemini (default) or openrouter.
# Gemini speech transcription remains separate from this choice.
INTAKE_LLM_PROVIDER=gemini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# The free endpoint says not to upload confidential/personal information.
# Enable ONLY in a dedicated instance containing fictional test conversations.
OPENROUTER_SYNTHETIC_TEST_MODE=false

# Optional: Google sign-in (OAuth 2.0). Leave blank to hide/disable it.
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# and add an authorised redirect URI matching GOOGLE_REDIRECT_URI below.
#   Local Vite redirect URI: http://localhost:5173/api/auth/google/callback
#   Set the local value explicitly; on Vercel use your deployed HTTPS origin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
